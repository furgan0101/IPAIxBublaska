# LiteLLM gateway credentials for the live AI analyst (logic/verification.py).
# Leaving LITELLM_API_KEY empty or USE_LIVE_AI=false keeps the pipeline in mock
# mode — ZERO external calls, no credits burned (hackathon guardrail).
LITELLM_API_KEY=your_key_here
USE_LIVE_AI=false
USE_VISION=false
# FAILSAFE: hard cap on gateway calls per process, protecting the API quota.
# Dedup already prevents re-analysing seen reports across restarts. 0 = unlimited.
LLM_MAX_CALLS=300

# --- Live data ingestion (real OSINT feeds) ---------------------------------
# Flip to true to poll real open-data sources (NINA civil-protection warnings,
# Presseportal police/fire RSS, Mastodon hashtags) instead of serving the
# synthetic mock feed. All sources are keyless. Mock stays the offline default.
FEEDS_ENABLED=false
FEEDS_POLL_INTERVAL_S=120
FEEDS_RETENTION_HOURS=24

# Demo sector (Konstanz) + spatial filter radius (km, metric).
SECTOR_LAT=47.6603
SECTOR_LON=9.1758
SECTOR_RADIUS_KM=40

# Sources (comma-separated where plural). Add more Presseportal newsrooms or
# Mastodon tags here for volume — no code changes needed.
NINA_ARS=083350000000
PRESSEPORTAL_FEEDS=https://www.presseportal.de/rss/dienststelle_110973.rss2
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TAGS=konstanz,bodensee,hochwasser,unwetter,blaulicht,katwarn,sturm

# Nominatim fallback geocoding for unresolved place hints (keyless; cached in
# SQLite and rate-limited per the OSM usage policy). Gazetteer runs first.
NOMINATIM_ENABLED=true
