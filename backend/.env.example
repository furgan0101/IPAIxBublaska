# LiteLLM gateway credentials for the live AI analyst (logic/verification.py).
# USE_LIVE_AI=true runs the LLM on every report (spends credits). Leaving
# LITELLM_API_KEY empty or USE_LIVE_AI=false falls back to the deterministic
# heuristic filter — real logic, ZERO external LLM calls.
LITELLM_API_KEY=your_key_here
USE_LIVE_AI=true
USE_VISION=false
# FAILSAFE: hard cap on gateway calls per process, protecting the API quota.
# Dedup already prevents re-analysing seen reports across restarts. 0 = unlimited.
LLM_MAX_CALLS=300
# Print the full LLM request + raw response for every gateway call to the server
# console (true by default). Set false to silence the per-call I/O dump.
LLM_VERBOSE=true

# --- Live data ingestion (real OSINT feeds) ---------------------------------
# The only source of served data: real keyless open-data sources (NINA
# civil-protection warnings, Presseportal police/fire RSS, Mastodon hashtags).
# There is no synthetic feed — when the feeds are quiet, the dashboard is empty.
FEEDS_ENABLED=true
FEEDS_POLL_INTERVAL_S=120
FEEDS_RETENTION_HOURS=24

# Demo sector (Konstanz) + spatial filter radius (km, metric).
SECTOR_LAT=47.6603
SECTOR_LON=9.1758
SECTOR_RADIUS_KM=40

# Sources (comma-separated where plural). Add more Presseportal newsrooms or
# Mastodon tags here for volume — no code changes needed.
NINA_ARS=083350000000
PRESSEPORTAL_FEEDS=https://www.presseportal.de/rss/dienststelle_110973.rss2
MASTODON_INSTANCE=https://mastodon.social
# City-agnostic crisis topics only (no hardcoded city tags) so every searched
# city is equal; the UI scopes results geographically, not by tag.
MASTODON_TAGS=hochwasser,unwetter,polizei,feuerwehr,brand,unfall,sturm,gewitter,blaulicht,katwarn

# Nominatim fallback geocoding for unresolved place hints (keyless; cached in
# SQLite and rate-limited per the OSM usage policy). Gazetteer runs first.
NOMINATIM_ENABLED=true

# National mode: ingest crisis posts countrywide (geocoded unbounded, no sector
# gate) so searching ANY German city in the UI surfaces its live news. Set false
# to restrict ingestion to the Konstanz sector only.
INGEST_NATIONAL=true
